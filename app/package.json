{
  "name": "biblioteca-web",
  "version": "0.1.0",
  "private": true,
  "description": "Biblioteca en linea: Worker + assets + D1 (Drizzle ORM, FTS5, Access)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:fts": "drizzle-kit generate --custom --name=fts",
    "db:apply:local": "wrangler d1 execute biblioteca --local --file",
    "db:apply:remote": "wrangler d1 execute biblioteca --remote --file",
    "db:seed:local": "wrangler d1 execute biblioteca --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute biblioteca --remote --file=./seed/seed.sql",
    "seed:dump": "uv run --project .. ../scripts/volcar_seed.py",
    "db:usuario": "node ../scripts/crear_usuario.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
