{
  // Despues de `npx wrangler d1 create biblioteca`, pega aqui el database_id.
  "name": "biblioteca-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // El Worker decide antes que el asset: protege /editar, /nuevo y la API.
    "run_worker_first": ["/api/*", "/editar.html", "/nuevo.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biblioteca",
      "database_id": "REEMPLAZAR-con-el-id-de-wrangler-d1-create"
    }
  ]
}
