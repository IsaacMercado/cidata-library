{
  "name": "@biblioteca/web",
  "version": "1.0.0",
  "private": true,
  "description": "Biblioteca en línea: Worker + assets + D1 (Hono, Drizzle, FTS5)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:fts": "drizzle-kit generate --custom --name=fts",
    "db:migrate:local": "wrangler d1 migrations apply biblioteca --local",
    "db:migrate:remote": "wrangler d1 migrations apply biblioteca --remote",
    "db:seed:local": "wrangler d1 execute biblioteca --local --file=../../data/derived/seed.sql",
    "db:seed:remote": "wrangler d1 execute biblioteca --remote --file=../../data/derived/seed.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.136.1"
  }
}
