/**
 * Worker configuration.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * `compatibility_date` pins runtime behavior. Raise it only after testing
 * `npm run dev` and `npm run check`.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cidata-library",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  // Optional: custom domain.
  // "routes": [{ "pattern": "biblioteca.example.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker must run before the asset server for write pages and the API.
    // Include both clean routes (/editar) and the legacy .html routes.
    "run_worker_first": [
      "/api/*",
      "/editar",
      "/editar.html",
      "/nuevo",
      "/nuevo.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biblioteca",
      "database_id": "82ffabde-f5b1-4ca3-96f2-1195162c5931"
    }
  ]
}
